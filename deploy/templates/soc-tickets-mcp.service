# systemd unit for the SOC ticket API MCP server (Track C, C3 — 2026-08-08).
#
# Run on the SOC host (the one with the canonical
# ~/.openclaw/soc_tickets.jsonl — typically thing1 for the
# SIEM fleet).
#
# Install:
#   sudo cp scripts/soc/soc-tickets-mcp/soc-tickets-mcp.service \
#           /etc/systemd/system/soc-tickets-mcp.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now soc-tickets-mcp
#
# Verifies:
#   curl -sS http://127.0.0.1:8768/healthz
#   curl -sS http://127.0.0.1:8768/tools
#
# Notes:
#   - The unit binds 127.0.0.1:8768 (loopback). If you need a
#     remote agent, set SOC_TICKET_MCP_BIND=lan in the
#     Environment= block AND add a firewall rule.
#   - Writes are OFF by default. To enable create_ticket /
#     update_ticket / close_ticket, set
#     SOC_TICKET_MCP_ALLOW_WRITES=1 in the Environment= block.
#     Leave it off in environments where the SOC agents
#     shouldn't be opening real tickets (e.g. dry runs).

[Unit]
Description=SOC ticket API MCP server (read-only by default)
Documentation=file:///opt/soc-openclaw/services/soc-tickets-mcp/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SOC_USER__
Group=__SOC_USER__
WorkingDirectory=/opt/soc-openclaw
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="SOC_TICKET_MCP_ALLOW_WRITES=0"
ExecStart=/usr/bin/python3 /opt/soc-openclaw/services/soc-tickets-mcp/server.py
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=soc-tickets-mcp

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/__SOC_USER__/.openclaw

[Install]
WantedBy=multi-user.target
