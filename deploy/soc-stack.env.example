# soc-stack.env — copy to soc-stack.env, edit, then run install.sh
# Everything is derived from these four knobs.

# Where this repo is deployed
SOC_HOME=/opt/soc-openclaw

# OS user the services run as
SOC_USER=wez

# Runtime state root (secrets + JSONL/sqlite data live under here)
SOC_STATE_DIR=/home/wez/.openclaw/soc

# OpenClaw sub-agent workspaces + logs
SOC_AGENTS_DIR=/home/wez/soc-agents
SOC_LOGS_DIR=/home/wez/logs

# Secrets (KEY=*** env files, chmod 600 — see docs/security-notes.md)
SOC_SECRETS_DIR=/home/wez/.openclaw/soc/secrets

# C2 manager binding: loopback (recommended) or lan
SOC_MANAGER_BIND=loopback

# Optional: path to an agentic_ai project checkout providing the full
# SecurityOperationsAgent triage backend. Empty = lite triage via the
# OpenClaw soc-triage sub-agent.
AGENTIC_AI_PATH=